<body>

<div class="header">

<h1>PAUL ACADEMY</h1>

<p>Homework & Assignment System</p>

</div>


<div class="container">


<!-- CREATE HOMEWORK -->

<div class="card">

<h2>➕ Create Homework</h2>

<label>Grade</label>

<select id="grade">

<option value="1">Grade 1</option>
<option value="2">Grade 2</option>
<option value="3">Grade 3</option>
<option value="4">Grade 4</option>
<option value="5">Grade 5</option>
<option value="6">Grade 6</option>
<option value="7">Grade 7</option>
<option value="8">Grade 8</option>
<option value="9">Grade 9</option>
<option value="10">Grade 10</option>
<option value="11">Grade 11</option>
<option value="12">Grade 12</option>

</select>


<label>Subject</label>

<input
id="subject"
placeholder="Example: Mathematics"
>


<label>Homework Title</label>

<input
id="title"
placeholder="Example: Algebra Exercise"
>


<label>Questions / Instructions</label>

<textarea
id="questions"
placeholder="Write homework questions here..."
></textarea>


<button onclick="createHomework()">

Save Homework

</button>

</div>


<!-- HOMEWORK LIST -->

<div class="card">

<h2>📚 Homework</h2>

<div id="homeworkList"></div>

</div>

</div>


<script>

let homework =
JSON.parse(
localStorage.getItem("paulHomework")
) || [];


function createHomework(){

const grade =
document.getElementById("grade").value;

const subject =
document.getElementById("subject").value.trim();

const title =
document.getElementById("title").value.trim();

const questions =
document.getElementById("questions").value.trim();


if(!subject  !title  !questions){

alert("Please fill all fields.");

return;

}


homework.push({

id:Date.now(),

grade:grade,

subject:subject,

title:title,

questions:questions,

answers:[]

});


localStorage.setItem(
"paulHomework",
JSON.stringify(homework)
);


document.getElementById("subject").value="";
document.getElementById("title").value="";
document.getElementById("questions").value="";


displayHomework();

alert("✅ Homework created!");

}


function displayHomework(){

const list =
document.getElementById("homeworkList");

list.innerHTML="";


if(homework.length === 0){

list.innerHTML =
"<p>No homework available.</p>";

return;

}


homework.forEach((hw,index)=>{

const div =
document.createElement("div");

div.className="homework";


div.innerHTML=

<h3>
${hw.title}
</h3>

<p>
<strong>Grade:</strong>
${hw.grade}
</p>

<p>
<strong>Subject:</strong>
${hw.subject}
</p>

<p>
<strong>Questions:</strong>
</p>

<p>
${hw.questions}
</p>


<div class="answer">

<h4>✍️ Student Answer</h4>

<textarea
id="answer${index}"
placeholder="Write your answer here..."
></textarea>

<button
onclick="submitAnswer(${index})">

Submit Answer

</button>

</div>

;


list.appendChild(div);

});

}


function submitAnswer(index){

const answer =
document.getElementById(
"answer" + index
).value.trim();


if(!answer){

alert("Please write your answer.");

return;

}
